# ==============================================================================
# E-TİCARET ARBİTRAJ RADARI - ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# ==============================================================================
# Bu dosyayı .env olarak kopyalayıp kendi bilgilerinizi girin.
# Public GitHub reposunda bu değerleri Settings -> Secrets -> Actions altına ekleyin.

# Telegram Bildirim Ayarları
TELEGRAM_BOT_TOKEN=1234567890:AAH_ornek_bot_token_buraya_gelecek
TELEGRAM_CHAT_ID=-1001234567890

# Çalışma ve Durum Ayarları
# İlk çalışmada mevcut tüm ürünleri Telegram'a spamlamamak için False önerilir.
NOTIFY_ON_FIRST_RUN=False
PRICE_DROP_RE_NOTIFY_PERCENT=5.0

# Ticari ve Arbitraj Eşikleri
MAX_BASKET_PRICE=5500
MIN_TOTAL_DISCOUNT_RATE=40
MIN_NET_PROFIT_TL=550
MIN_ROI_PERCENT=30

# Tarama Ayarları
MAX_PAGES_PER_CATEGORY=6
REQUEST_TIMEOUT=25
MAX_WORKERS=4
LOOP_INTERVAL_SECONDS=900

# İsteğe Bağlı Proxy (Örn: http://user:pass@host:port)
HTTP_PROXY=
